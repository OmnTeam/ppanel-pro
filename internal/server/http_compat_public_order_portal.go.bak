package server

import (
	"context"
	"encoding/json"
	"fmt"
	"strconv"
	"strings"

	publicorderv1 "github.com/OmnTeam/ppanel-pro/api/public/order/v1"
	publicpaymentv1 "github.com/OmnTeam/ppanel-pro/api/public/payment/v1"
	publicportalv1 "github.com/OmnTeam/ppanel-pro/api/public/portal/v1"
	"github.com/OmnTeam/ppanel-pro/ent"
	"github.com/OmnTeam/ppanel-pro/ent/proxysubscribe"
	"github.com/OmnTeam/ppanel-pro/internal/data"
	khttp "github.com/go-kratos/kratos/v2/transport/http"
	"google.golang.org/protobuf/types/known/emptypb"
)

type legacyPublicOrderCompat interface {
	CloseOrder(context.Context, *publicorderv1.CloseOrderRequest) (*publicorderv1.OrderCloseReply, error)
	QueryOrderDetail(context.Context, *publicorderv1.QueryOrderDetailRequest) (*publicorderv1.OrderDetailReply, error)
	QueryOrderList(context.Context, *publicorderv1.QueryOrderListRequest) (*publicorderv1.OrderListReply, error)
	PreCreateOrder(context.Context, *publicorderv1.PreCreateOrderRequest) (*publicorderv1.OrderPreCreateReply, error)
	Purchase(context.Context, *publicorderv1.PurchaseRequest) (*publicorderv1.PurchaseReply, error)
	Recharge(context.Context, *publicorderv1.RechargeRequest) (*publicorderv1.RechargeReply, error)
	Renewal(context.Context, *publicorderv1.RenewalRequest) (*publicorderv1.RenewalReply, error)
	ResetTraffic(context.Context, *publicorderv1.ResetTrafficRequest) (*publicorderv1.TrafficResetReply, error)
}

type legacyPublicPaymentCompat interface {
	GetAvailablePaymentMethods(context.Context, *emptypb.Empty) (*publicpaymentv1.PaymentMethodsReply, error)
}

type legacyPublicPortalCompat interface {
	GetSubscription(context.Context, *publicportalv1.GetSubscriptionRequest) (*publicportalv1.GetSubscriptionReply, error)
	PrePurchaseOrder(context.Context, *publicportalv1.PrePurchaseOrderRequest) (*publicportalv1.PrePurchaseOrderReply, error)
	Purchase(context.Context, *publicportalv1.PurchaseRequest) (*publicportalv1.PurchaseReply, error)
	GetAvailablePaymentMethods(context.Context, *emptypb.Empty) (*publicportalv1.GetAvailablePaymentMethodsReply, error)
	PurchaseCheckout(context.Context, *publicportalv1.PurchaseCheckoutRequest) (*publicportalv1.PurchaseCheckoutReply, error)
	QueryPurchaseOrder(context.Context, *publicportalv1.QueryPurchaseOrderRequest) (*publicportalv1.QueryPurchaseOrderReply, error)
}

type compatPaymentMethod struct {
	ID          int64  `json:"id"`
	Name        string `json:"name"`
	Platform    string `json:"platform"`
	Description string `json:"description"`
	Icon        string `json:"icon"`
	FeeMode     uint   `json:"fee_mode"`
	FeePercent  int64  `json:"fee_percent"`
	FeeAmount   int64  `json:"fee_amount"`
}

type compatStripePayment struct {
	Method         string `json:"method"`
	ClientSecret   string `json:"client_secret"`
	PublishableKey string `json:"publishable_key"`
}

type compatSubscribeDiscount struct {
	Quantity int64   `json:"quantity"`
	Discount float64 `json:"discount"`
}

type compatTrafficLimit struct {
	StatType     string `json:"stat_type"`
	StatValue    int64  `json:"stat_value"`
	TrafficUsage int64  `json:"traffic_usage"`
	SpeedLimit   int64  `json:"speed_limit"`
}

type compatSubscribe struct {
	ID                string                    `json:"id"`
	Name              string                    `json:"name"`
	Language          string                    `json:"language"`
	Description       string                    `json:"description"`
	UnitPrice         int64                     `json:"unit_price"`
	UnitTime          string                    `json:"unit_time"`
	Discount          []compatSubscribeDiscount `json:"discount"`
	Replacement       int64                     `json:"replacement"`
	Inventory         int64                     `json:"inventory"`
	Traffic           int64                     `json:"traffic"`
	SpeedLimit        int64                     `json:"speed_limit"`
	DeviceLimit       int64                     `json:"device_limit"`
	Quota             int64                     `json:"quota"`
	Nodes             []string                  `json:"nodes"`
	NodeTags          []string                  `json:"node_tags"`
	NodeGroupIds      []string                  `json:"node_group_ids,omitempty"`
	NodeGroupId       string                    `json:"node_group_id"`
	TrafficLimit      []compatTrafficLimit      `json:"traffic_limit"`
	Show              bool                      `json:"show"`
	Sell              bool                      `json:"sell"`
	Sort              int64                     `json:"sort"`
	DeductionRatio    int64                     `json:"deduction_ratio"`
	AllowDeduction    bool                      `json:"allow_deduction"`
	ResetCycle        int64                     `json:"reset_cycle"`
	RenewalReset      bool                      `json:"renewal_reset"`
	ShowOriginalPrice bool                      `json:"show_original_price"`
	CreatedAt         int64                     `json:"created_at"`
	UpdatedAt         int64                     `json:"updated_at"`
}

type compatOrderDetail struct {
	ID             int64               `json:"id"`
	UserID         int64               `json:"user_id"`
	OrderNo        string              `json:"order_no"`
	Type           uint8               `json:"type"`
	Quantity       int64               `json:"quantity"`
	Price          int64               `json:"price"`
	Amount         int64               `json:"amount"`
	GiftAmount     int64               `json:"gift_amount"`
	Discount       int64               `json:"discount"`
	Coupon         string              `json:"coupon"`
	CouponDiscount int64               `json:"coupon_discount"`
	Commission     int64               `json:"commission,omitempty"`
	Payment        compatPaymentMethod `json:"payment"`
	Method         string              `json:"method"`
	FeeAmount      int64               `json:"fee_amount"`
	TradeNo        string              `json:"trade_no"`
	Status         uint8               `json:"status"`
	SubscribeID    int64               `json:"subscribe_id"`
	Subscribe      compatSubscribe     `json:"subscribe"`
	CreatedAt      int64               `json:"created_at"`
	UpdatedAt      int64               `json:"updated_at"`
}

type compatOrderListData struct {
	Total int64               `json:"total"`
	List  []compatOrderDetail `json:"list"`
}

type compatOrderResultData struct {
	OrderNo string `json:"order_no"`
}

type compatPreOrderResponse struct {
	Price          int64  `json:"price"`
	Amount         int64  `json:"amount"`
	Discount       int64  `json:"discount"`
	GiftAmount     int64  `json:"gift_amount"`
	Coupon         string `json:"coupon"`
	CouponDiscount int64  `json:"coupon_discount"`
	FeeAmount      int64  `json:"fee_amount"`
}

type compatPaymentMethodListData struct {
	List []compatPaymentMethod `json:"list"`
}

type compatGetSubscriptionData struct {
	List []compatSubscribe `json:"list"`
}

type compatQueryPurchaseOrderData struct {
	OrderNo        string              `json:"order_no"`
	Subscribe      compatSubscribe     `json:"subscribe"`
	Quantity       int64               `json:"quantity"`
	Price          int64               `json:"price"`
	Amount         int64               `json:"amount"`
	Discount       int64               `json:"discount"`
	Coupon         string              `json:"coupon"`
	CouponDiscount int64               `json:"coupon_discount"`
	FeeAmount      int64               `json:"fee_amount"`
	Payment        compatPaymentMethod `json:"payment"`
	Status         uint8               `json:"status"`
	CreatedAt      int64               `json:"created_at"`
	Token          string              `json:"token,omitempty"`
}

type compatCheckoutOrderResponse struct {
	Type        string               `json:"type"`
	CheckoutURL string               `json:"checkout_url,omitempty"`
	Stripe      *compatStripePayment `json:"stripe,omitempty"`
}

type compatCloseOrderRequest struct {
	OrderNo string `json:"orderNo"`
}

type compatOrderDetailRequest struct {
	OrderNo string `json:"order_no" form:"order_no"`
}

type compatOrderListRequest struct {
	Page int64 `form:"page"`
	Size int64 `form:"size"`
}

type compatPurchaseOrderRequest struct {
	SubscribeID compatFlexibleInt64 `json:"subscribe_id" form:"subscribe_id"`
	Quantity    int64               `json:"quantity"`
	Payment     compatFlexibleInt64 `json:"payment" form:"payment"`
	Coupon      string              `json:"coupon,omitempty"`
}

type compatRechargeOrderRequest struct {
	Amount  compatFlexibleInt64 `json:"amount" form:"amount"`
	Payment compatFlexibleInt64 `json:"payment" form:"payment"`
}

type compatRenewalOrderRequest struct {
	UserSubscribeID compatFlexibleInt64 `json:"user_subscribe_id" form:"user_subscribe_id"`
	Quantity        int64               `json:"quantity" form:"quantity"`
	Payment         compatFlexibleInt64 `json:"payment" form:"payment"`
	Coupon          string              `json:"coupon,omitempty"`
}

type compatResetTrafficOrderRequest struct {
	UserSubscribeID compatFlexibleInt64 `json:"user_subscribe_id" form:"user_subscribe_id"`
	Payment         compatFlexibleInt64 `json:"payment" form:"payment"`
}

type compatPortalPurchaseRequest struct {
	AuthType       string              `json:"auth_type"`
	Identifier     string              `json:"identifier"`
	Password       string              `json:"password,omitempty"`
	Payment        compatFlexibleInt64 `json:"payment" form:"payment"`
	SubscribeID    compatFlexibleInt64 `json:"subscribe_id" form:"subscribe_id"`
	Quantity       compatFlexibleInt64 `json:"quantity" form:"quantity"`
	Coupon         string              `json:"coupon,omitempty"`
	InviteCode     string              `json:"invite_code,omitempty"`
	TurnstileToken string              `json:"turnstile_token,omitempty"`
}

type compatPortalPrePurchaseOrderRequest struct {
	Payment     compatFlexibleInt64 `json:"payment,omitempty" form:"payment"`
	SubscribeID compatFlexibleInt64 `json:"subscribe_id" form:"subscribe_id"`
	Quantity    compatFlexibleInt64 `json:"quantity" form:"quantity"`
	Coupon      string              `json:"coupon,omitempty"`
}

type compatGetSubscriptionRequest struct {
	Language string `form:"language"`
}

type compatCheckoutOrderRequest struct {
	OrderNo   string `json:"orderNo"`
	ReturnURL string `json:"returnUrl,omitempty"`
}

type compatQueryPurchaseOrderRequest struct {
	AuthType   string `form:"auth_type"`
	Identifier string `form:"identifier"`
	OrderNo    string `form:"order_no"`
}

func registerLegacyPublicOrderCompatRoutes(r *khttp.Router, dataLayer *data.Data, publicOrder legacyPublicOrderCompat) {
	if r == nil || publicOrder == nil {
		return
	}

	r.POST("/v1/public/order/close", func(ctx khttp.Context) error {
		var req compatCloseOrderRequest
		_ = ctx.Bind(&req)
		_ = ctx.BindQuery(&req)
		if err := compatValidateRequiredString(req.OrderNo, "CloseOrderRequest", "OrderNo"); err != nil {
			return compatJSONError(ctx, err)
		}

		_, err := compatMiddleware(ctx, &req, func(inner context.Context, request interface{}) (interface{}, error) {
			in := request.(*compatCloseOrderRequest)
			_, err := publicOrder.CloseOrder(inner, &publicorderv1.CloseOrderRequest{OrderNo: in.OrderNo})
			return nil, err
		})
		if err != nil {
			return compatJSONError(ctx, err)
		}
		return compatJSON(ctx, nil)
	})

	r.GET("/v1/public/order/detail", func(ctx khttp.Context) error {
		var req compatOrderDetailRequest
		_ = ctx.Bind(&req)
		_ = ctx.BindQuery(&req)
		if req.OrderNo == "" && ctx.Request() != nil && ctx.Request().URL != nil {
			req.OrderNo = strings.TrimSpace(ctx.Request().URL.Query().Get("order_no"))
			if req.OrderNo == "" {
				req.OrderNo = strings.TrimSpace(ctx.Request().URL.Query().Get("orderNo"))
			}
		}
		if err := compatValidateRequiredString(req.OrderNo, "QueryOrderDetailRequest", "OrderNo"); err != nil {
			return compatJSONError(ctx, err)
		}

		out, err := compatMiddleware(ctx, &req, func(inner context.Context, request interface{}) (interface{}, error) {
			in := request.(*compatOrderDetailRequest)
			reply, err := publicOrder.QueryOrderDetail(inner, &publicorderv1.QueryOrderDetailRequest{OrderNo: in.OrderNo})
			if err != nil {
				return nil, err
			}
			var data *publicorderv1.OrderDetail
			if reply != nil {
				data = reply.Data
			}
			return compatLegacyOrderDetail(inner, dataLayer, data), nil
		})
		if err != nil {
			return compatJSONError(ctx, err)
		}
		return compatJSON(ctx, out)
	})

	r.GET("/v1/public/order/list", func(ctx khttp.Context) error {
		var req compatOrderListRequest
		_ = ctx.Bind(&req)
		_ = ctx.BindQuery(&req)
		if req.Page == 0 {
			return compatJSONError(ctx, compatFieldValidationError("QueryOrderListRequest", "Page", "required"))
		}
		if req.Size == 0 {
			return compatJSONError(ctx, compatFieldValidationError("QueryOrderListRequest", "Size", "required"))
		}

		out, err := compatMiddleware(ctx, &req, func(inner context.Context, request interface{}) (interface{}, error) {
			in := request.(*compatOrderListRequest)
			reply, err := publicOrder.QueryOrderList(inner, &publicorderv1.QueryOrderListRequest{
				Page: int32(in.Page),
				Size: int32(in.Size),
			})
			if err != nil {
				return nil, err
			}

			list := make([]compatOrderDetail, 0)
			if reply != nil && reply.Data != nil {
				list = compatLegacyOrderDetails(inner, dataLayer, reply.Data.List)
			}
			total := int64(0)
			if reply != nil && reply.Data != nil {
				total = int64(reply.Data.Total)
			}
			return &compatOrderListData{
				Total: total,
				List:  list,
			}, nil
		})
		if err != nil {
			return compatJSONError(ctx, err)
		}
		return compatJSON(ctx, out)
	})

	r.POST("/v1/public/order/pre", func(ctx khttp.Context) error {
		var req compatPurchaseOrderRequest
		_ = ctx.Bind(&req)
		_ = ctx.BindQuery(&req)
		if req.Quantity == 0 {
			return compatJSONError(ctx, compatFieldValidationError("PurchaseOrderRequest", "Quantity", "required"))
		}
		if req.Quantity < 0 {
			return compatJSONError(ctx, compatFieldValidationError("PurchaseOrderRequest", "Quantity", "gt"))
		}
		if req.Quantity > 1000 {
			return compatJSONError(ctx, compatFieldValidationError("PurchaseOrderRequest", "Quantity", "lte"))
		}

		out, err := compatMiddleware(ctx, &req, func(inner context.Context, request interface{}) (interface{}, error) {
			in := request.(*compatPurchaseOrderRequest)
			reply, err := publicOrder.PreCreateOrder(inner, &publicorderv1.PreCreateOrderRequest{
				Type:        1,
				SubscribeId: strconv.FormatInt(int64(in.SubscribeID), 10),
				Quantity:    int32(in.Quantity),
				Coupon:      in.Coupon,
				Payment:     strconv.FormatInt(int64(in.Payment), 10),
			})
			if err != nil {
				return nil, err
			}
			var data *publicorderv1.OrderPreCreateData
			if reply != nil {
				data = reply.Data
			}
			if data == nil {
				return &compatPreOrderResponse{Coupon: in.Coupon}, nil
			}
			return &compatPreOrderResponse{
				Price:          compatParseInt64String(data.Price),
				Amount:         compatParseInt64String(data.Amount),
				Discount:       compatParseInt64String(data.Discount),
				GiftAmount:     compatParseInt64String(data.GiftAmount),
				Coupon:         in.Coupon,
				CouponDiscount: compatParseInt64String(data.CouponDiscount),
				FeeAmount:      compatParseInt64String(data.FeeAmount),
			}, nil
		})
		if err != nil {
			return compatJSONError(ctx, err)
		}
		return compatJSON(ctx, out)
	})

	r.POST("/v1/public/order/recharge", func(ctx khttp.Context) error {
		var req compatRechargeOrderRequest
		_ = ctx.Bind(&req)
		_ = ctx.BindQuery(&req)
		if req.Amount == 0 {
			return compatJSONError(ctx, compatFieldValidationError("RechargeOrderRequest", "Amount", "required"))
		}
		if req.Amount < 0 {
			return compatJSONError(ctx, compatFieldValidationError("RechargeOrderRequest", "Amount", "gt"))
		}
		if req.Amount > 2000000000 {
			return compatJSONError(ctx, compatFieldValidationError("RechargeOrderRequest", "Amount", "lte"))
		}

		out, err := compatMiddleware(ctx, &req, func(inner context.Context, request interface{}) (interface{}, error) {
			in := request.(*compatRechargeOrderRequest)
			reply, err := publicOrder.Recharge(inner, &publicorderv1.RechargeRequest{
				Amount:  strconv.FormatInt(int64(in.Amount), 10),
				Payment: strconv.FormatInt(int64(in.Payment), 10),
			})
			if err != nil {
				return nil, err
			}
			orderNo := ""
			if reply != nil && reply.Data != nil {
				orderNo = reply.Data.OrderNo
			}
			return &compatOrderResultData{OrderNo: orderNo}, nil
		})
		if err != nil {
			return compatJSONError(ctx, err)
		}
		return compatJSON(ctx, out)
	})

	r.POST("/v1/public/order/renewal", func(ctx khttp.Context) error {
		var req compatRenewalOrderRequest
		_ = ctx.Bind(&req)
		_ = ctx.BindQuery(&req)
		if req.Quantity > 1000 {
			return compatJSONError(ctx, compatFieldValidationError("RenewalOrderRequest", "Quantity", "lte"))
		}

		out, err := compatMiddleware(ctx, &req, func(inner context.Context, request interface{}) (interface{}, error) {
			in := request.(*compatRenewalOrderRequest)
			reply, err := publicOrder.Renewal(inner, &publicorderv1.RenewalRequest{
				UserSubscribeId: fmt.Sprintf("%d", in.UserSubscribeID),
				Quantity:        int32(in.Quantity),
				Coupon:          in.Coupon,
				Payment:         strconv.FormatInt(int64(in.Payment), 10),
			})
			if err != nil {
				return nil, err
			}
			orderNo := ""
			if reply != nil && reply.Data != nil {
				orderNo = reply.Data.OrderNo
			}
			return &compatOrderResultData{OrderNo: orderNo}, nil
		})
		if err != nil {
			return compatJSONError(ctx, err)
		}
		return compatJSON(ctx, out)
	})

	r.POST("/v1/public/order/reset", func(ctx khttp.Context) error {
		var req compatResetTrafficOrderRequest
		_ = ctx.Bind(&req)
		_ = ctx.BindQuery(&req)

		out, err := compatMiddleware(ctx, &req, func(inner context.Context, request interface{}) (interface{}, error) {
			in := request.(*compatResetTrafficOrderRequest)
			reply, err := publicOrder.ResetTraffic(inner, &publicorderv1.ResetTrafficRequest{
				UserSubscribeId: fmt.Sprintf("%d", in.UserSubscribeID),
				Payment:         strconv.FormatInt(int64(in.Payment), 10),
			})
			if err != nil {
				return nil, err
			}
			orderNo := ""
			if reply != nil && reply.Data != nil {
				orderNo = reply.Data.OrderNo
			}
			return &compatOrderResultData{OrderNo: orderNo}, nil
		})
		if err != nil {
			return compatJSONError(ctx, err)
		}
		return compatJSON(ctx, out)
	})
}

func registerLegacyPublicPaymentCompatRoutes(r *khttp.Router, publicPayment legacyPublicPaymentCompat) {
	if r == nil || publicPayment == nil {
		return
	}

	r.GET("/v1/public/payment/methods", func(ctx khttp.Context) error {
		out, err := compatMiddleware(ctx, nil, func(inner context.Context, req interface{}) (interface{}, error) {
			reply, err := publicPayment.GetAvailablePaymentMethods(inner, &emptypb.Empty{})
			if err != nil {
				return nil, err
			}
			list := make([]compatPaymentMethod, 0)
			if reply != nil && reply.Data != nil {
				list = compatLegacyPaymentMethods(reply.Data.List)
			}
			return &compatPaymentMethodListData{List: list}, nil
		})
		if err != nil {
			return compatJSONError(ctx, err)
		}
		return compatJSON(ctx, out)
	})
}

func registerLegacyPublicPortalCompatRoutes(r *khttp.Router, dataLayer *data.Data, publicPortal legacyPublicPortalCompat) {
	if r == nil || publicPortal == nil {
		return
	}

	r.GET("/v1/public/portal/subscribe", func(ctx khttp.Context) error {
		var req compatGetSubscriptionRequest
		_ = ctx.Bind(&req)
		_ = ctx.BindQuery(&req)

		out, err := compatMiddleware(ctx, &req, func(inner context.Context, request interface{}) (interface{}, error) {
			in := request.(*compatGetSubscriptionRequest)
			serviceReq := &publicportalv1.GetSubscriptionRequest{}
			if strings.TrimSpace(in.Language) != "" {
				language := in.Language
				serviceReq.Language = &language
			}
			reply, err := publicPortal.GetSubscription(inner, serviceReq)
			if err != nil {
				return nil, err
			}

			ids := make([]int64, 0)
			if reply != nil && reply.Data != nil {
				for _, item := range reply.Data.List {
					ids = append(ids, compatParseInt64String(item.GetId()))
				}
			}
			subscribeMap := compatLoadSubscribeMap(inner, dataLayer, ids)
			list := make([]compatSubscribe, 0, len(ids))
			if reply != nil && reply.Data != nil {
				for _, item := range reply.Data.List {
					subscribeID := compatParseInt64String(item.GetId())
					if subscribe, ok := subscribeMap[subscribeID]; ok && subscribe != nil {
						list = append(list, *subscribe)
						continue
					}
					list = append(list, compatLegacySubscribeFromPortal(item))
				}
			}

			return &compatGetSubscriptionData{List: list}, nil
		})
		if err != nil {
			return compatJSONError(ctx, err)
		}
		return compatJSON(ctx, out)
	})

	r.POST("/v1/public/portal/pre", func(ctx khttp.Context) error {
		var req compatPortalPrePurchaseOrderRequest
		_ = ctx.Bind(&req)
		_ = ctx.BindQuery(&req)

		out, err := compatMiddleware(ctx, &req, func(inner context.Context, request interface{}) (interface{}, error) {
			in := request.(*compatPortalPrePurchaseOrderRequest)
			serviceReq := &publicportalv1.PrePurchaseOrderRequest{
				SubscribeId: strconv.FormatInt(int64(in.SubscribeID), 10),
				Quantity:    strconv.FormatInt(int64(in.Quantity), 10),
			}
			if strings.TrimSpace(in.Coupon) != "" {
				coupon := in.Coupon
				serviceReq.Coupon = &coupon
			}
			if int64(in.Payment) != 0 {
				paymentID := strconv.FormatInt(int64(in.Payment), 10)
				serviceReq.PaymentId = &paymentID
			}
			reply, err := publicPortal.PrePurchaseOrder(inner, serviceReq)
			if err != nil {
				return nil, err
			}
			var data *publicportalv1.PrePurchaseOrderData
			if reply != nil {
				data = reply.Data
			}
			if data == nil {
				return &compatPreOrderResponse{}, nil
			}
			return &compatPreOrderResponse{
				Price:          compatParseInt64String(data.Price),
				Amount:         compatParseInt64String(data.Amount),
				Discount:       compatParseInt64String(data.Discount),
				Coupon:         data.Coupon,
				CouponDiscount: compatParseInt64String(data.CouponDiscount),
				FeeAmount:      compatParseInt64String(data.FeeAmount),
			}, nil
		})
		if err != nil {
			return compatJSONError(ctx, err)
		}
		return compatJSON(ctx, out)
	})

	r.POST("/v1/public/portal/purchase", func(ctx khttp.Context) error {
		var req compatPortalPurchaseRequest
		_ = ctx.Bind(&req)
		_ = ctx.BindQuery(&req)

		out, err := compatMiddleware(ctx, &req, func(inner context.Context, request interface{}) (interface{}, error) {
			in := request.(*compatPortalPurchaseRequest)
			serviceReq := &publicportalv1.PurchaseRequest{
				SubscribeId: strconv.FormatInt(int64(in.SubscribeID), 10),
				Quantity:    strconv.FormatInt(int64(in.Quantity), 10),
				Identifier:  in.Identifier,
				AuthType:    in.AuthType,
				Password:    in.Password,
				PaymentId:   strconv.FormatInt(int64(in.Payment), 10),
			}
			if strings.TrimSpace(in.Coupon) != "" {
				coupon := in.Coupon
				serviceReq.Coupon = &coupon
			}
			if strings.TrimSpace(in.InviteCode) != "" {
				inviteCode := in.InviteCode
				serviceReq.InviteCode = &inviteCode
			}
			reply, err := publicPortal.Purchase(inner, serviceReq)
			if err != nil {
				return nil, err
			}
			orderNo := ""
			if reply != nil && reply.Data != nil {
				orderNo = reply.Data.OrderNo
			}
			return &compatOrderResultData{OrderNo: orderNo}, nil
		})
		if err != nil {
			return compatJSONError(ctx, err)
		}
		return compatJSON(ctx, out)
	})

	r.GET("/v1/public/portal/payment-method", func(ctx khttp.Context) error {
		out, err := compatMiddleware(ctx, nil, func(inner context.Context, req interface{}) (interface{}, error) {
			reply, err := publicPortal.GetAvailablePaymentMethods(inner, &emptypb.Empty{})
			if err != nil {
				return nil, err
			}
			list := make([]compatPaymentMethod, 0)
			if reply != nil && reply.Data != nil {
				list = compatLegacyPortalPaymentMethods(reply.Data.Methods)
			}
			return &compatPaymentMethodListData{List: list}, nil
		})
		if err != nil {
			return compatJSONError(ctx, err)
		}
		return compatJSON(ctx, out)
	})

	r.POST("/v1/public/portal/order/checkout", func(ctx khttp.Context) error {
		var req compatCheckoutOrderRequest
		_ = ctx.Bind(&req)
		_ = ctx.BindQuery(&req)

		out, err := compatMiddleware(ctx, &req, func(inner context.Context, request interface{}) (interface{}, error) {
			in := request.(*compatCheckoutOrderRequest)
			serviceReq := &publicportalv1.PurchaseCheckoutRequest{OrderNo: in.OrderNo}
			if strings.TrimSpace(in.ReturnURL) != "" {
				returnURL := in.ReturnURL
				serviceReq.ReturnUrl = &returnURL
			}
			reply, err := publicPortal.PurchaseCheckout(inner, serviceReq)
			if err != nil {
				return nil, err
			}

			result := &compatCheckoutOrderResponse{}
			if reply != nil && reply.Data != nil {
				result.Type = reply.Data.Type
				if reply.Data.CheckoutUrl != nil {
					result.CheckoutURL = *reply.Data.CheckoutUrl
				}
				if reply.Data.Stripe != nil {
					result.Stripe = &compatStripePayment{
						Method:         reply.Data.Stripe.Method,
						ClientSecret:   reply.Data.Stripe.ClientSecret,
						PublishableKey: reply.Data.Stripe.PublishableKey,
					}
				}
			}
			return result, nil
		})
		if err != nil {
			return compatJSONError(ctx, err)
		}
		return compatJSON(ctx, out)
	})

	r.GET("/v1/public/portal/order/status", func(ctx khttp.Context) error {
		var req compatQueryPurchaseOrderRequest
		_ = ctx.Bind(&req)
		_ = ctx.BindQuery(&req)

		out, err := compatMiddleware(ctx, &req, func(inner context.Context, request interface{}) (interface{}, error) {
			in := request.(*compatQueryPurchaseOrderRequest)
			reply, err := publicPortal.QueryPurchaseOrder(inner, &publicportalv1.QueryPurchaseOrderRequest{
				OrderNo:    in.OrderNo,
				AuthType:   in.AuthType,
				Identifier: in.Identifier,
			})
			if err != nil {
				return nil, err
			}

			result := &compatQueryPurchaseOrderData{}
			if reply != nil && reply.Data != nil {
				result.OrderNo = reply.Data.OrderNo
				subscribeID := int64(0)
				if reply.Data.Subscribe != nil {
					subscribeID = compatParseInt64String(reply.Data.Subscribe.Id)
				}
				if subscribeID != 0 {
					if subscribeMap := compatLoadSubscribeMap(inner, dataLayer, []int64{subscribeID}); subscribeMap != nil && subscribeMap[subscribeID] != nil {
						result.Subscribe = *subscribeMap[subscribeID]
					} else if reply.Data.Subscribe != nil {
						result.Subscribe = compatLegacySubscribeFromPortal(reply.Data.Subscribe)
					}
				} else if reply.Data.Subscribe != nil {
					result.Subscribe = compatLegacySubscribeFromPortal(reply.Data.Subscribe)
				}
				result.Quantity = compatParseInt64String(reply.Data.Quantity)
				result.Price = compatParseInt64String(reply.Data.Price)
				result.Amount = compatParseInt64String(reply.Data.Amount)
				result.Discount = compatParseInt64String(reply.Data.Discount)
				result.Coupon = reply.Data.Coupon
				result.CouponDiscount = compatParseInt64String(reply.Data.CouponDiscount)
				result.FeeAmount = compatParseInt64String(reply.Data.FeeAmount)
				result.Payment = compatLegacyPortalPaymentMethod(reply.Data.Payment)
				result.Status = uint8(reply.Data.Status)
				result.CreatedAt = compatParseInt64String(reply.Data.CreatedAt)
				result.Token = reply.Data.Token
			}
			return result, nil
		})
		if err != nil {
			return compatJSONError(ctx, err)
		}
		return compatJSON(ctx, out)
	})
}

func compatLegacyOrderDetails(ctx context.Context, dataLayer *data.Data, items []*publicorderv1.OrderDetail) []compatOrderDetail {
	if len(items) == 0 {
		return []compatOrderDetail{}
	}

	subscribeIDs := make([]int64, 0, len(items))
	for _, item := range items {
		subscribeIDs = append(subscribeIDs, compatParseInt64String(item.GetSubscribeId()))
	}
	subscribeMap := compatLoadSubscribeMap(ctx, dataLayer, subscribeIDs)

	list := make([]compatOrderDetail, 0, len(items))
	for _, item := range items {
		list = append(list, compatLegacyOrderDetailWithMap(item, subscribeMap))
	}
	return list
}

func compatLegacyOrderDetail(ctx context.Context, dataLayer *data.Data, item *publicorderv1.OrderDetail) compatOrderDetail {
	subscribeID := compatParseInt64String(item.GetSubscribeId())
	subscribeMap := compatLoadSubscribeMap(ctx, dataLayer, []int64{subscribeID})
	return compatLegacyOrderDetailWithMap(item, subscribeMap)
}

func compatLegacyOrderDetailWithMap(item *publicorderv1.OrderDetail, subscribeMap map[int64]*compatSubscribe) compatOrderDetail {
	detail := compatOrderDetail{
		ID:             compatParseInt64String(item.GetId()),
		UserID:         compatParseInt64String(item.GetUserId()),
		OrderNo:        item.GetOrderNo(),
		Type:           uint8(item.GetType()),
		Quantity:       int64(item.GetQuantity()),
		Price:          compatParseInt64String(item.GetPrice()),
		Amount:         compatParseInt64String(item.GetAmount()),
		GiftAmount:     compatParseInt64String(item.GetGiftAmount()),
		Discount:       compatParseInt64String(item.GetDiscount()),
		Coupon:         item.GetCoupon(),
		CouponDiscount: compatParseInt64String(item.GetCouponDiscount()),
		Commission:     compatParseInt64String(item.GetCommission()),
		Payment:        compatLegacyOrderPaymentMethod(item.GetPayment()),
		Method:         item.GetMethod(),
		FeeAmount:      compatParseInt64String(item.GetFeeAmount()),
		TradeNo:        item.GetTradeNo(),
		Status:         uint8(item.GetStatus()),
		SubscribeID:    compatParseInt64String(item.GetSubscribeId()),
		CreatedAt:      compatParseInt64String(item.GetCreatedAt()),
		UpdatedAt:      compatParseInt64String(item.GetUpdatedAt()),
	}
	if subscribeMap != nil {
		if subscribe, ok := subscribeMap[detail.SubscribeID]; ok && subscribe != nil {
			detail.Subscribe = *subscribe
		}
	}
	return detail
}

func compatLegacyOrderPaymentMethod(item *publicorderv1.PaymentMethod) compatPaymentMethod {
	if item == nil {
		return compatPaymentMethod{}
	}
	return compatPaymentMethod{
		ID:          compatParseInt64String(item.GetId()),
		Name:        item.GetName(),
		Platform:    item.GetPlatform(),
		Description: item.GetDescription(),
		Icon:        item.GetIcon(),
		FeeMode:     uint(item.GetFeeMode()),
		FeePercent:  compatParseInt64String(item.GetFeePercent()),
		FeeAmount:   compatParseInt64String(item.GetFeeAmount()),
	}
}

func compatLegacyPaymentMethods(items []*publicpaymentv1.PaymentMethod) []compatPaymentMethod {
	list := make([]compatPaymentMethod, 0, len(items))
	for _, item := range items {
		if item == nil {
			continue
		}
		list = append(list, compatPaymentMethod{
			ID:          compatParseInt64String(item.GetId()),
			Name:        item.GetName(),
			Platform:    item.GetPlatform(),
			Description: item.GetDescription(),
			Icon:        item.GetIcon(),
			FeeMode:     uint(item.GetFeeMode()),
			FeePercent:  compatParseInt64String(item.GetFeePercent()),
			FeeAmount:   compatParseInt64String(item.GetFeeAmount()),
		})
	}
	return list
}

func compatLegacyPortalPaymentMethods(items []*publicportalv1.PaymentMethod) []compatPaymentMethod {
	list := make([]compatPaymentMethod, 0, len(items))
	for _, item := range items {
		list = append(list, compatLegacyPortalPaymentMethod(item))
	}
	return list
}

func compatLegacyPortalPaymentMethod(item *publicportalv1.PaymentMethod) compatPaymentMethod {
	if item == nil {
		return compatPaymentMethod{}
	}
	return compatPaymentMethod{
		ID:          compatParseInt64String(item.GetId()),
		Name:        item.GetName(),
		Platform:    item.GetPlatform(),
		Description: item.GetDescription(),
		Icon:        item.GetIcon(),
		FeeMode:     uint(item.GetFeeMode()),
		FeePercent:  compatParseInt64String(item.GetFeePercent()),
		FeeAmount:   compatParseInt64String(item.GetFeeAmount()),
	}
}

func compatLoadSubscribeMap(ctx context.Context, dataLayer *data.Data, ids []int64) map[int64]*compatSubscribe {
	result := make(map[int64]*compatSubscribe)
	if dataLayer == nil || dataLayer.DB() == nil {
		return result
	}

	filtered := make([]int64, 0, len(ids))
	seen := make(map[int64]struct{}, len(ids))
	for _, id := range ids {
		if id == 0 {
			continue
		}
		if _, ok := seen[id]; ok {
			continue
		}
		seen[id] = struct{}{}
		filtered = append(filtered, id)
	}
	if len(filtered) == 0 {
		return result
	}

	items, err := dataLayer.DB().ProxySubscribe.Query().
		Where(proxysubscribe.IDIn(filtered...)).
		All(ctx)
	if err != nil {
		return result
	}
	for _, item := range items {
		result[item.ID] = compatLegacySubscribeFromEnt(item)
	}
	return result
}

func compatLegacySubscribeFromEnt(item *ent.ProxySubscribe) *compatSubscribe {
	if item == nil {
		return &compatSubscribe{}
	}

	description := ""
	if item.Description != nil {
		description = *item.Description
	}

	var discounts []compatSubscribeDiscount
	if item.Discount != nil && strings.TrimSpace(*item.Discount) != "" {
		_ = json.Unmarshal([]byte(*item.Discount), &discounts)
	}

	nodeGroupID := int64(0)
	if item.NodeGroupID != nil {
		nodeGroupID = *item.NodeGroupID
	}
	deductionRatio := int64(0)
	if item.DeductionRatio != nil {
		deductionRatio = *item.DeductionRatio
	}
	resetCycle := int64(0)
	if item.ResetCycle != nil {
		resetCycle = *item.ResetCycle
	}

	return &compatSubscribe{
		ID:                strconv.FormatInt(item.ID, 10),
		Name:              item.Name,
		Language:          item.Language,
		Description:       description,
		UnitPrice:         item.UnitPrice,
		UnitTime:          item.UnitTime,
		Discount:          discounts,
		Replacement:       item.Replacement,
		Inventory:         item.Inventory,
		Traffic:           item.Traffic,
		SpeedLimit:        item.SpeedLimit,
		DeviceLimit:       item.DeviceLimit,
		Quota:             item.Quota,
		Nodes:             nil,
		NodeTags:          nil,
		NodeGroupIds:      compatInt64SliceToStringSlice(item.NodeGroupIds),
		NodeGroupId:       strconv.FormatInt(nodeGroupID, 10),
		TrafficLimit:      nil,
		Show:              item.Show,
		Sell:              item.Sell,
		Sort:              item.Sort,
		DeductionRatio:    deductionRatio,
		AllowDeduction:    item.AllowDeduction,
		ResetCycle:        resetCycle,
		RenewalReset:      item.RenewalReset,
		ShowOriginalPrice: item.ShowOriginalPrice,
		CreatedAt:         item.CreatedAt.UnixMilli(),
		UpdatedAt:         item.UpdatedAt.UnixMilli(),
	}
}

func compatLegacySubscribeFromPortal(item *publicportalv1.SubscribeInfo) compatSubscribe {
	if item == nil {
		return compatSubscribe{}
	}

	discounts := make([]compatSubscribeDiscount, 0, len(item.Discount))
	for _, discount := range item.Discount {
		if discount == nil {
			continue
		}
		discounts = append(discounts, compatSubscribeDiscount{
			Quantity: compatParseInt64String(discount.Quantity),
			Discount: compatParseFloat64String(discount.Discount),
		})
	}

	return compatSubscribe{
		ID:             item.Id,
		Name:           item.Name,
		Language:       item.Language,
		Description:    item.GetDescription(),
		UnitPrice:      compatParseInt64String(item.UnitPrice),
		UnitTime:       item.UnitTime,
		Discount:       discounts,
		Replacement:    compatParseInt64String(item.Replacement),
		Inventory:      compatParseInt64String(item.Inventory),
		Traffic:        compatParseInt64String(item.Traffic),
		SpeedLimit:     compatParseInt64String(item.SpeedLimit),
		DeviceLimit:    compatParseInt64String(item.DeviceLimit),
		Quota:          compatParseInt64String(item.Quota),
		Nodes:          nil,
		NodeTags:       nil,
		NodeGroupIds:   nil,
		NodeGroupId:    "",
		TrafficLimit:   nil,
		Show:           item.Show,
		Sell:           item.Sell,
		Sort:           compatParseInt64String(item.Sort),
		DeductionRatio: compatParseInt64String(item.DeductionRatio),
		AllowDeduction: item.AllowDeduction,
		ResetCycle:     compatParseInt64String(item.ResetCycle),
		RenewalReset:   item.RenewalReset,
		CreatedAt:      compatParseInt64String(item.CreatedAt),
		UpdatedAt:      compatParseInt64String(item.UpdatedAt),
	}
}

func compatParseInt64String(value string) int64 {
	parsed, _ := strconv.ParseInt(strings.TrimSpace(value), 10, 64)
	return parsed
}

func compatParseFloat64String(value string) float64 {
	parsed, _ := strconv.ParseFloat(strings.TrimSpace(value), 64)
	return parsed
}

func compatFieldValidationError(typeName, fieldName, tag string) error {
	return compatParamError(fmt.Sprintf(
		"Key: '%s.%s' Error:Field validation for '%s' failed on the '%s' tag",
		typeName,
		fieldName,
		fieldName,
		tag,
	))
}
