package server

import (
	"strconv"
	"strings"
)

type compatSubscribeDiscount struct {
	Quantity int64   `json:"quantity"`
	Discount float64 `json:"discount"`
}

type compatTrafficLimit struct {
	StatType     string `json:"stat_type"`
	StatValue    int64  `json:"stat_value"`
	TrafficUsage int64  `json:"traffic_usage"`
	SpeedLimit   int64  `json:"speed_limit"`
}

type compatSubscribe struct {
	ID                string                    `json:"id"`
	Name              string                    `json:"name"`
	Language          string                    `json:"language"`
	Description       string                    `json:"description"`
	UnitPrice         int64                     `json:"unit_price"`
	UnitTime          string                    `json:"unit_time"`
	Discount          []compatSubscribeDiscount `json:"discount"`
	Replacement       int64                     `json:"replacement"`
	Inventory         int64                     `json:"inventory"`
	Traffic           int64                     `json:"traffic"`
	SpeedLimit        int64                     `json:"speed_limit"`
	DeviceLimit       int64                     `json:"device_limit"`
	Quota             int64                     `json:"quota"`
	Nodes             []string                  `json:"nodes"`
	NodeTags          []string                  `json:"node_tags"`
	NodeGroupIds      []string                  `json:"node_group_ids,omitempty"`
	NodeGroupId       string                    `json:"node_group_id"`
	TrafficLimit      []compatTrafficLimit      `json:"traffic_limit"`
	Show              bool                      `json:"show"`
	Sell              bool                      `json:"sell"`
	Sort              int64                     `json:"sort"`
	DeductionRatio    int64                     `json:"deduction_ratio"`
	AllowDeduction    bool                      `json:"allow_deduction"`
	ResetCycle        int64                     `json:"reset_cycle"`
	RenewalReset      bool                      `json:"renewal_reset"`
	ShowOriginalPrice bool                      `json:"show_original_price"`
	CreatedAt         int64                     `json:"created_at"`
	UpdatedAt         int64                     `json:"updated_at"`
}

func compatParseInt64String(value string) int64 {
	parsed, _ := strconv.ParseInt(strings.TrimSpace(value), 10, 64)
	return parsed
}

func compatParseFloat64String(value string) float64 {
	parsed, _ := strconv.ParseFloat(strings.TrimSpace(value), 64)
	return parsed
}
