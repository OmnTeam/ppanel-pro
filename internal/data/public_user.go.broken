		r.logger.Errorf("[UpdateUserNotify] 更新失败: %v", err)
		return errors.InternalServer("DATABASE_ERROR", "更新通知设置失败")
	}

	return nil
}

// UpdateUserPassword 更新密码
// ⚠️ 完整复刻原项目逻辑（updateUserPasswordLogic.go）
func (r *publicUserRepo) UpdateUserPassword(ctx context.Context, userID int64, password string) error {
	r.logger.Infof("[UpdateUserPassword] userID: %d", userID)

	// 加密密码
	encryptedPassword := encodePassword(password)

	err := r.data.db.ProxyUser.UpdateOneID(int(userID)).
		SetPassword(encryptedPassword).
		Exec(ctx)

	if err != nil {
		r.logger.Errorf("[UpdateUserPassword] 更新失败: %v", err)
		return errors.InternalServer("DATABASE_ERROR", "更新密码失败")
	}

	return nil
}

// encodePassword 加密密码（需实现实际的加密逻辑）
func encodePassword(password string) string {
	hash := sha256.Sum256([]byte(password))
	return hex.EncodeToString(hash[:])
}

// calculateRemainingAmount 计算剩余金额
// ⚠️ 完整复刻原项目逻辑（calculateRemainingAmount.go）
func (r *publicUserRepo) calculateRemainingAmount(ctx context.Context, userID, userSubscribeID int64) (int64, error) {
	r.logger.Infof("[calculateRemainingAmount] 开始计算: userID=%d, userSubscribeID=%d", userID, userSubscribeID)

	// 1. 查询UserSubscribe
	userSub, err := r.data.db.ProxyUserSubscribe.Query().
		Where(
			proxyusersubscribe.IDEQ(int(userSubscribeID)),
		).
		Only(ctx)

	if err != nil {
		r.logger.Errorf("[calculateRemainingAmount] FindOneUserSubscribe failed: %v", err)
		return 0, errors.NotFound("SUBSCRIBE_NOT_FOUND", "用户订阅不存在")
	}

	// 2. 如果OrderId为0（管理员创建的订阅）
	if userSub.OrderID == 0 {
		return 0, nil
	}

	// 3. 查询Subscribe并验证AllowDeduction
	subscribe, err := r.data.db.ProxySubscribe.Get(ctx, userSub.SubscribeID)
	if err != nil {
		r.logger.Errorf("[calculateRemainingAmount] FindSubscribe failed: %v", err)
		return 0, errors.NotFound("SUBSCRIBE_NOT_FOUND", "订阅套餐不存在")
	}
	if !subscribe.AllowDeduction {
		return 0, errors.BadRequest("DEDUCTION_NOT_ALLOWED", "该订阅套餐不支持扣费")
	}

	// 4. 验证Status = 1（使用中）
	if userSub.Status == nil || *userSub.Status != 1 {
		return 0, errors.BadRequest("SUBSCRIBE_NOT_IN_USE", "订阅套餐未在使用中")
	}

	// 5. 查询Order详情
	order, err := r.data.db.ProxyOrder.Get(ctx, int64(userSub.OrderID))
	if err != nil {
		r.logger.Errorf("[calculateRemainingAmount] FindOneDetails failed: %v", err)
		return 0, errors.InternalServer("DATABASE_ERROR", "查询订单详情失败")
	}

	// 6. 计算订单金额
	orderAmount := order.Amount + order.GiftAmount

	// 7. 简化的剩余金额计算
	// 实际项目使用 deduction.CalculateRemainingAmount，这里简化为按时间比例计算
	now := time.Now()
	startTime := userSub.StartTime
	expireTime := userSub.ExpireTime

	totalDuration := expireTime.Sub(startTime).Seconds()
	remainingDuration := expireTime.Sub(now).Seconds()

	if totalDuration <= 0 || remainingDuration <= 0 {
		return 0, nil
	}

	// 按剩余时间比例计算退款
	remainingRatio := remainingDuration / totalDuration
	remainingAmount := int64(float64(orderAmount) * remainingRatio)

	r.logger.Infof("[calculateRemainingAmount] userSubscribeID: %d, remainingAmount: %d", userSubscribeID, remainingAmount)
	return remainingAmount, nil
}

