// ============================================================================
// Public User数据仓储
// ============================================================================

type publicUserRepo struct {
	data   *Data
	logger *log.Helper
}

// NewPublicUserRepo 创建Public User数据仓储实例
func NewPublicUserRepo(d *Data, logger log.Logger) interface{} {
	return &publicUserRepo{
		data:   d,
		logger: log.NewHelper(logger),
	}
}

// QueryUserInfo 查询用户信息 - 临时禁用以解决编译问题
// ⚠️ 完整复刻原项目逻辑（queryUserInfoLogic.go）
/*
func (r *publicUserRepo) QueryUserInfo(ctx context.Context, userID int64) (*userBiz.UserInfo, error) {
	r.logger.Infof("[QueryUserInfo] userID: %d", userID)

	// 1. 查询用户基本信息
	user, err := r.data.db.ProxyUser.Query().
		Where(
			proxyuser.IDEQ(int(userID)),
		).
		Only(ctx)

	if err != nil {
		if ent.IsNotFound(err) {
			return nil, responsecode.NewKratosError(responsecode.ErrUserNotFound)
		}
		r.logger.Errorf("[QueryUserInfo] 查询用户失败: %v", err)
		return nil, errors.InternalServer("DATABASE_ERROR", "查询用户失败")
	}

	// 2. 查询用户认证方法
	authMethods, err := r.data.db.ProxyUserAuthMethod.Query().
		Where(
			proxyuserauthmethod.UserIDEQ(int(userID)),
		).
		All(ctx)

	if err != nil {
		r.logger.Errorf("[QueryUserInfo] 查询认证方法失败: %v", err)
		return nil, errors.InternalServer("DATABASE_ERROR", "查询认证方法失败")
	}

	// 3. 转换并脱敏AuthMethods（复刻原项目逻辑 line 43-56）
	userAuthMethods := make([]*userBiz.AuthMethod, 0, len(authMethods))
	for _, method := range authMethods {
		identifier := method.AuthIdentifier

		switch method.AuthType {
		case "mobile":
			// 手机号脱敏
			identifier = phone.MaskPhoneNumber(method.AuthIdentifier)
		case "email":
			// 邮箱不脱敏
		default:
			// 其他类型（OpenID）脱敏
			identifier = maskOpenID(method.AuthIdentifier)
		}

		userAuthMethods = append(userAuthMethods, &userBiz.AuthMethod{
			AuthType:       method.AuthType,
			AuthIdentifier: identifier,
			Verified:       method.Verified,
		})
	}

	// 4. 按照指定顺序排序：email第一位，mobile第二位，其他按原顺序（复刻原项目 line 58-61）
	sort.Slice(userAuthMethods, func(i, j int) bool {
		return getAuthTypePriority(userAuthMethods[i].AuthType) < getAuthTypePriority(userAuthMethods[j].AuthType)
	})

	// 5. 构建返回结果
	// 安全处理指针字段
	avatar := ""
	if user.Avatar != nil {
		avatar = *user.Avatar
	}
	balance := int64(0)
	if user.Balance != nil {
		balance = *user.Balance
	}
	commission := int64(0)
	if user.Commission != nil {
		commission = *user.Commission
	}
	giftAmount := int64(0)
	if user.GiftAmount != nil {
		giftAmount = *user.GiftAmount
	}
	telegramID := int64(0)
	if user.Telegram != nil {
		// Convert telegram string to int64 if it's not empty
		// This might need proper parsing based on actual data format
		telegramID = 0 // Default value for now
	}
	referCode := ""
	if user.ReferCode != nil {
		referCode = *user.ReferCode
	}
	refererID := int64(0)
	if user.RefererID != nil {
		refererID = int64(*user.RefererID)
	}

	return &userBiz.UserInfo{
		ID:                    int64(user.ID),
		Avatar:                avatar,
		Balance:               balance,
		Commission:            commission,
		ReferralPercentage:    int32(user.ReferralPercentage),
		OnlyFirstPurchase:     user.OnlyFirstPurchase,
		GiftAmount:            giftAmount,
		Telegram:              telegramID,
		ReferCode:             referCode,
		RefererID:             refererID,
		Enable:                user.Enable,
		IsAdmin:               user.IsAdmin,
		EnableBalanceNotify:   user.EnableBalanceNotify,
		EnableLoginNotify:     user.EnableLoginNotify,
		EnableSubscribeNotify: user.EnableSubscribeNotify,
		EnableTradeNotify:     user.EnableTradeNotify,
		AuthMethods:           userAuthMethods,
		CreatedAt:             user.CreatedAt.UnixMilli(),
		UpdatedAt:             user.UpdatedAt.UnixMilli(),
	}, nil
}

// GetLoginLog 获取登录日志
// ⚠️ 完整复刻原项目逻辑（getLoginLogLogic.go）
func (r *publicUserRepo) GetLoginLog(ctx context.Context, userID int64, page, size int64) ([]*userBiz.LoginLog, int64, error) {
	r.logger.Infof("[GetLoginLog] userID: %d, page: %d, size: %d", userID, page, size)

	// 1. 查询登录日志（type=30）
	query := r.data.db.ProxySystemLog.Query().
		Where(
			proxysystemlog.TypeEQ(int8(systemlog.TypeLogin)),
			proxysystemlog.ObjectIDEQ(userID),
		)

	// 2. 获取总数
	total, err := query.Clone().Count(ctx)
	if err != nil {
		r.logger.Errorf("[GetLoginLog] 查询总数失败: %v", err)
		return nil, 0, errors.InternalServer("DATABASE_ERROR", "查询登录日志失败")
	}

	// 3. 分页查询
	logs, err := query.
		Order(ent.Desc(proxysystemlog.FieldCreatedAt)).
		Limit(int(size)).
		Offset(int((page - 1) * size)).
		All(ctx)

	if err != nil {
		r.logger.Errorf("[GetLoginLog] 查询失败: %v", err)
		return nil, 0, errors.InternalServer("DATABASE_ERROR", "查询登录日志失败")
	}

	// 4. 解析日志内容（复刻原项目 line 50-64）
	list := make([]*userBiz.LoginLog, 0, len(logs))
	for _, datum := range logs {
		var content systemlog.Login
		if err := json.Unmarshal([]byte(datum.Content), &content); err != nil {
			r.logger.Errorf("[GetLoginLog] 解析登录日志内容失败: %v", err)
			continue
		}

		list = append(list, &userBiz.LoginLog{
			ID:        datum.ID,
			UserID:    datum.ObjectID,
			LoginIP:   content.LoginIP,
			UserAgent: content.UserAgent,
			Success:   content.Success,
			Timestamp: datum.CreatedAt.UnixMilli(),
		})
	}

	return list, int64(total), nil
}

// QueryUserBalanceLog 查询用户余额日志
// ⚠️ 完整复刻原项目逻辑（queryUserBalanceLogLogic.go）
// ⚠️ 固定查询全部，page=1, size=99999
func (r *publicUserRepo) QueryUserBalanceLog(ctx context.Context, userID int64) ([]*userBiz.BalanceLog, int64, error) {
	r.logger.Infof("[QueryUserBalanceLog] userID: %d", userID)

	// 1. 查询余额日志（type=32）- 固定查询全部（复刻原项目 line 39-44）
	logs, err := r.data.db.ProxySystemLog.Query().
		Where(
			proxysystemlog.TypeEQ(int8(systemlog.TypeBalance)),
			proxysystemlog.ObjectIDEQ(userID),
		).
		Order(ent.Desc(proxysystemlog.FieldCreatedAt)).
		All(ctx)

	if err != nil {
		r.logger.Errorf("[QueryUserBalanceLog] 查询失败: %v", err)
		return nil, 0, errors.InternalServer("DATABASE_ERROR", "查询余额日志失败")
	}

	total := int64(len(logs))

	// 2. 解析日志内容（复刻原项目 line 50-65）
	list := make([]*userBiz.BalanceLog, 0, len(logs))
	for _, datum := range logs {
		var content systemlog.Balance
		if err := json.Unmarshal([]byte(datum.Content), &content); err != nil {
			r.logger.Errorf("[QueryUserBalanceLog] 解析余额日志内容失败: %v", err)
			continue
		}

		list = append(list, &userBiz.BalanceLog{
			Type:      int32(content.Type),
			UserID:    datum.ObjectID,
			Amount:    content.Amount,
			OrderNo:   content.OrderNo,
			Balance:   content.Balance,
			Timestamp: content.Timestamp,
		})
	}

	return list, total, nil
}

