// QueryUserAffiliate 查询用户推荐数量
// ⚠️ 完整复刻原项目逻辑（queryUserAffiliateLogic.go）
func (r *publicUserRepo) QueryUserAffiliate(ctx context.Context, userID int64) (registers int64, totalCommission int64, err error) {
	r.logger.Infof("[QueryUserAffiliate] userID: %d", userID)

	// 1. 查询推荐注册数（referer_id=当前用户的用户数量）
	total, err := r.data.db.ProxyUser.Query().
		Where(
			proxyuser.RefererIDEQ(int(userID)),
		).
		Count(ctx)

	if err != nil {
		r.logger.Errorf("[QueryUserAffiliate] 查询推荐用户数量失败: %v", err)
		return 0, 0, errors.InternalServer("DATABASE_ERROR", "查询推荐用户数量失败")
	}

	// 2. 查询佣金日志求和（复刻原项目 line 48-62）
	logs, err := r.data.db.ProxySystemLog.Query().
		Where(
			proxysystemlog.TypeEQ(int8(systemlog.TypeCommission)),
			proxysystemlog.ObjectIDEQ(userID),
		).
		All(ctx)

	if err != nil {
		r.logger.Errorf("[QueryUserAffiliate] 查询佣金日志失败: %v", err)
		return 0, 0, errors.InternalServer("DATABASE_ERROR", "查询佣金日志失败")
	}

	var sum int64
	for _, datum := range logs {
		var content systemlog.Commission
		if err := json.Unmarshal([]byte(datum.Content), &content); err != nil {
			r.logger.Errorf("[QueryUserAffiliate] 解析佣金日志内容失败: %v", err)
			continue
		}
		sum += content.Amount
	}

	return int64(total), sum, nil
}

// QueryUserAffiliateList 查询用户推荐列表
// ⚠️ 完整复刻原项目逻辑（queryUserAffiliateListLogic.go）
func (r *publicUserRepo) QueryUserAffiliateList(ctx context.Context, userID int64, page, size int64) ([]*userBiz.UserAffiliate, int64, error) {
	r.logger.Infof("[QueryUserAffiliateList] userID: %d, page: %d, size: %d", userID, page, size)

	// 1. 查询推荐用户列表
	query := r.data.db.ProxyUser.Query().
		Where(
			proxyuser.RefererIDEQ(int(userID)),
		)

	// 2. 获取总数
	total, err := query.Clone().Count(ctx)
	if err != nil {
		r.logger.Errorf("[QueryUserAffiliateList] 查询总数失败: %v", err)
		return nil, 0, errors.InternalServer("DATABASE_ERROR", "查询推荐用户列表失败")
	}

	// 3. 分页查询
	users, err := query.
		Order(ent.Desc(proxyuser.FieldID)).
		Limit(int(size)).
		Offset(int((page - 1) * size)).
		All(ctx)

	if err != nil {
		r.logger.Errorf("[QueryUserAffiliateList] 查询失败: %v", err)
		return nil, 0, errors.InternalServer("DATABASE_ERROR", "查询推荐用户列表失败")
	}

	// 4. 转换结果（复刻原项目 line 49-57）
	list := make([]*userBiz.UserAffiliate, 0, len(users))
	for _, user := range users {
		// 获取用户的AuthMethod并脱敏（复刻原项目 line 52）
		identifier := r.getAffiliateAuthMethod(ctx, int64(user.ID))

		avatar := ""
		if user.Avatar != nil {
			avatar = *user.Avatar
		}

		list = append(list, &userBiz.UserAffiliate{
			Avatar:       avatar,
			Identifier:   identifier,
			RegisteredAt: user.CreatedAt.UnixMilli(),
			Enable:       user.Enable,
		})
	}

	return list, int64(total), nil
}

// GetOAuthMethods 获取OAuth方法
// ⚠️ 完整复刻原项目逻辑（getOAuthMethodsLogic.go）
func (r *publicUserRepo) GetOAuthMethods(ctx context.Context, userID int64) ([]*userBiz.AuthMethod, error) {
	r.logger.Infof("[GetOAuthMethods] userID: %d", userID)

	// 1. 查询用户的所有认证方法
	methods, err := r.data.db.ProxyUserAuthMethod.Query().
		Where(
			proxyuserauthmethod.UserIDEQ(int(userID)),
		).
		All(ctx)

	if err != nil {
		r.logger.Errorf("[GetOAuthMethods] 查询认证方法失败: %v", err)
		return nil, errors.InternalServer("DATABASE_ERROR", "查询认证方法失败")
	}

	// 2. 转换结果（复刻原项目 line 43-44）
	list := make([]*userBiz.AuthMethod, 0, len(methods))
	for _, method := range methods {
		list = append(list, &userBiz.AuthMethod{
			AuthType:       method.AuthType,
			AuthIdentifier: method.AuthIdentifier,
			Verified:       method.Verified,
		})
	}

	return list, nil
}

// ============================================================================
// 辅助函数
// ============================================================================

// getAuthTypePriority 获取认证类型的排序优先级
// ⚠️ 完整复刻原项目逻辑（queryUserInfoLogic.go line 67-79）
// email: 1 (第一位)
// mobile: 2 (第二位)
// 其他类型: 100+ (后续位置)
func getAuthTypePriority(authType string) int {
	switch authType {
	case "email":
		return 1
	case "mobile":
		return 2
	default:
		return 100
	}
}

// maskOpenID 脱敏 OpenID，只保留前 3 和后 3 位
// ⚠️ 完整复刻原项目逻辑（queryUserInfoLogic.go line 82-98）
func maskOpenID(openID string) string {
	length := len(openID)
	if length <= 6 {
		return "***" // 如果 ID 太短，直接返回 "***"
	}

	// 计算中间需要被替换的 `*` 数量
	maskLength := length - 6
	mask := make([]byte, maskLength)
	for i := range mask {
		mask[i] = '*'
	}

	// 组合脱敏后的 OpenID
	return openID[:3] + string(mask) + openID[length-3:]
}

// getAffiliateAuthMethod 获取推荐用户的认证方法并脱敏
// ⚠️ 完整复刻原项目逻辑（queryUserAffiliateListLogic.go line 64-84）
func (r *publicUserRepo) getAffiliateAuthMethod(ctx context.Context, userID int64) string {
	// 查询用户的认证方法
	authMethods, err := r.data.db.ProxyUserAuthMethod.Query().
		Where(
			proxyuserauthmethod.UserIDEQ(int(userID)),
		).
		All(ctx)

	if err != nil || len(authMethods) == 0 {
		return ""
	}

	// 优先选择类型为"6"或"7"的认证方法（复刻原项目 line 68-73）
	var selectedMethod *ent.ProxyUserAuthMethod
	for _, am := range authMethods {
		if am.AuthType == "6" || am.AuthType == "7" {
			selectedMethod = am
			break
		}
	}

	// 如果没有找到类型6或7，使用第一个
	if selectedMethod == nil {
		selectedMethod = authMethods[0]
	}

	// 脱敏处理（复刻原项目 line 78-81）
	identifier := selectedMethod.AuthIdentifier
	hideTextLength := len(identifier) / 3
	if hideTextLength > 0 {
		identifier = identifier[0:hideTextLength] + "***" + identifier[hideTextLength*2:]
	}

	return identifier
}

