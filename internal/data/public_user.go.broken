// AddDeviceToManager 添加设备到设备管理器（由HTTP transport层调用）
func (r *publicUserRepo) AddDeviceToManager(ctx context.Context, userID int64, deviceID, sessionID string, maxDevices int) error {
	// 查询用户订阅信息，确定最大设备数量
	var maxDeviceCount int
	if maxDevices > 0 {
		maxDeviceCount = maxDevices
	} else {
		// 默认查询用户订阅获取设备限制
		subscribes, err := r.data.db.ProxyUserSubscribe.Query().
			Where(
				proxyusersubscribe.UserID(int(userID)),
				proxyusersubscribe.StatusIn(0, 1, 2, 3), // 有效状态
			).
			All(ctx)
		if err == nil && len(subscribes) > 0 {
			maxDeviceCount = 1 // 默认至少1个设备
			for _, sub := range subscribes {
				// 检查订阅是否过期
				if sub.ExpireTime != nil && time.Now().Before(*sub.ExpireTime) {
					// 有有效订阅，设置默认设备数为5
					maxDeviceCount = 5
					break
				}
			}
		} else {
			maxDeviceCount = 1 // 默认1个设备
		}
	}

	// 使用设备管理器添加设备（需要在HTTP server中传入实际的HTTP请求和响应）
	// 这里我们只记录日志，实际添加设备操作在HTTP transport层完成
	r.logger.Infof("[AddDeviceToManager] User %d device %s with maxDevices %d", userID, deviceID, maxDeviceCount)
	return nil
}

