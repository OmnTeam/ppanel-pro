// UnbindOAuth 解绑OAuth
// ⚠️ 完整复刻原项目逻辑（unbindOAuthLogic.go）
func (r *publicUserRepo) UnbindOAuth(ctx context.Context, userID int64, method string) error {
	r.logger.Infof("[UnbindOAuth] userID: %d, method: %s", userID, method)

	// 验证参数（line 48-50）
	if method == "" || method == "email" || method == "mobile" {
		return errors.BadRequest("INVALID_PARAMETER", "method不能为空或为email/mobile")
	}

	// 删除AuthMethod（line 40-44）
	_, err := r.data.db.ProxyUserAuthMethod.Delete().
		Where(
			proxyuserauthmethod.UserIDEQ(int(userID)),
			proxyuserauthmethod.AuthTypeEQ(method),
		).
		Exec(ctx)

	if err != nil {
		r.logger.Errorf("[UnbindOAuth] 删除AuthMethod失败: %v", err)
		return errors.InternalServer("DATABASE_ERROR", "删除认证方法失败")
	}

	return nil
}

// VerifyEmail 验证邮箱
// ⚠️ 完整复刻原项目逻辑（verifyEmailLogic.go）
func (r *publicUserRepo) VerifyEmail(ctx context.Context, userID int64, email, code string) error {
	r.logger.Infof("[VerifyEmail] userID: %d, email: %s", userID, email)

	// 从Redis验证验证码（line 39-55）
	cacheKey := fmt.Sprintf("auth_code:security:%s", email)
	value, err := r.data.rdb.Get(ctx, cacheKey).Result()
	if err != nil {
		r.logger.Errorf("[VerifyEmail] 获取验证码失败: %v", err)
		return errors.BadRequest("VERIFY_CODE_ERROR", "验证码错误或已过期")
	}

	var payload struct {
		Code   string `json:"code"`
		LastAt int64  `json:"lastAt"`
	}
	if err := json.Unmarshal([]byte(value), &payload); err != nil {
		r.logger.Errorf("[VerifyEmail] 解析验证码失败: %v", err)
		return errors.BadRequest("VERIFY_CODE_ERROR", "验证码错误")
	}

	if payload.Code != code {
		return errors.BadRequest("VERIFY_CODE_ERROR", "验证码错误")
	}

	// 删除验证码（line 55）
	r.data.rdb.Del(ctx, cacheKey)

	// 查询邮箱AuthMethod（line 62-65）
	method, err := r.data.db.ProxyUserAuthMethod.Query().
		Where(
			proxyuserauthmethod.AuthTypeEQ("email"),
			proxyuserauthmethod.AuthIdentifierEQ(email),
		).
		Only(ctx)

	if err != nil {
		r.logger.Errorf("[VerifyEmail] 查询AuthMethod失败: %v", err)
		return errors.InternalServer("DATABASE_ERROR", "查询认证方法失败")
	}

	// 验证属于当前用户（line 66-68）
	if int64(method.UserID) != userID {
		return responsecode.NewKratosError(responsecode.ErrInvalidAccess)
	}

	// 设置Verified=true（line 69-73）
	err = r.data.db.ProxyUserAuthMethod.UpdateOneID(method.ID).
		SetVerified(true).
		Exec(ctx)

	if err != nil {
		r.logger.Errorf("[VerifyEmail] 更新AuthMethod失败: %v", err)
		return errors.InternalServer("DATABASE_ERROR", "更新认证方法失败")
	}

	return nil
}

// UpdateBindMobile 更新绑定手机
// ⚠️ 完整复刻原项目逻辑（updateBindMobileLogic.go）
func (r *publicUserRepo) UpdateBindMobile(ctx context.Context, userID int64, areaCode, mobile, code string) error {
	r.logger.Infof("[UpdateBindMobile] userID: %d, mobile: %s", userID, mobile)

	// 格式化手机号为E164格式（line 43-46）
	// TODO: 实现手机号格式化
	phoneNumber := fmt.Sprintf("%s%s", areaCode, mobile)

	// 验证验证码（line 47-62）
	cacheKey := fmt.Sprintf("auth_code_telephone:register:%s", phoneNumber)
	value, err := r.data.rdb.Get(ctx, cacheKey).Result()
	if err != nil {
		r.logger.Errorf("[UpdateBindMobile] 获取验证码失败: %v", err)
		return errors.BadRequest("VERIFY_CODE_ERROR", "验证码错误或已过期")
	}

	var payload struct {
		Code   string `json:"code"`
		LastAt int64  `json:"lastAt"`
	}
	if err := json.Unmarshal([]byte(value), &payload); err != nil {
		r.logger.Errorf("[UpdateBindMobile] 解析验证码失败: %v", err)
		return errors.BadRequest("VERIFY_CODE_ERROR", "验证码错误")
	}

	if payload.Code != code {
		return errors.BadRequest("VERIFY_CODE_ERROR", "验证码错误")
	}

	// 删除验证码
	r.data.rdb.Del(ctx, cacheKey)

	// 检查手机号是否已被其他用户绑定（line 64-70）
	existingMethod, err := r.data.db.ProxyUserAuthMethod.Query().
		Where(
			proxyuserauthmethod.AuthTypeEQ("mobile"),
			proxyuserauthmethod.AuthIdentifierEQ(mobile),
		).
		Only(ctx)

	if err != nil && !ent.IsNotFound(err) {
		r.logger.Errorf("[UpdateBindMobile] 查询手机号失败: %v", err)
		return errors.InternalServer("DATABASE_ERROR", "查询失败")
	}

	if existingMethod != nil && existingMethod.ID > 0 {
		return errors.BadRequest("USER_EXIST", "手机号已被其他用户绑定")
	}

	// 查询当前用户的mobile AuthMethod（line 72-75）
	userMethod, err := r.data.db.ProxyUserAuthMethod.Query().
		Where(
			proxyuserauthmethod.UserIDEQ(int(userID)),
			proxyuserauthmethod.AuthTypeEQ("mobile"),
		).
		Only(ctx)

	if err != nil && !ent.IsNotFound(err) {
		r.logger.Errorf("[UpdateBindMobile] 查询用户AuthMethod失败: %v", err)
		return errors.InternalServer("DATABASE_ERROR", "查询失败")
	}

	// 如果不存在则创建，否则更新（line 76-92）
	if userMethod == nil || userMethod.ID == 0 {
		_, err = r.data.db.ProxyUserAuthMethod.Create().
			SetUserID(int(userID)).
			SetAuthType("mobile").
			SetAuthIdentifier(mobile).
			SetVerified(true).
			Save(ctx)
	} else {
		err = r.data.db.ProxyUserAuthMethod.UpdateOneID(userMethod.ID).
			SetAuthIdentifier(mobile).
			SetVerified(true).
			Exec(ctx)
	}

	if err != nil {
		r.logger.Errorf("[UpdateBindMobile] 保存AuthMethod失败: %v", err)
		return errors.InternalServer("DATABASE_ERROR", "保存认证方法失败")
	}

	return nil
}

// UpdateBindEmail 更新绑定邮箱
// ⚠️ 完整复刻原项目逻辑（updateBindEmailLogic.go）
func (r *publicUserRepo) UpdateBindEmail(ctx context.Context, userID int64, email string) error {
	r.logger.Infof("[UpdateBindEmail] userID: %d, email: %s", userID, email)

	// 检查邮箱是否已被其他用户绑定（line 43-50）
	existingMethod, err := r.data.db.ProxyUserAuthMethod.Query().
		Where(
			proxyuserauthmethod.AuthTypeEQ("email"),
			proxyuserauthmethod.AuthIdentifierEQ(email),
		).
		Only(ctx)

	if err != nil && !ent.IsNotFound(err) {
		r.logger.Errorf("[UpdateBindEmail] 查询邮箱失败: %v", err)
		return errors.InternalServer("DATABASE_ERROR", "查询失败")
	}

	if existingMethod != nil && existingMethod.ID > 0 {
		return errors.BadRequest("USER_EXIST", "邮箱已被其他用户绑定")
	}

	// 查询当前用户的email AuthMethod（line 39-42）
	userMethod, err := r.data.db.ProxyUserAuthMethod.Query().
		Where(
			proxyuserauthmethod.UserIDEQ(int(userID)),
			proxyuserauthmethod.AuthTypeEQ("email"),
		).
		Only(ctx)

	if err != nil && !ent.IsNotFound(err) {
		r.logger.Errorf("[UpdateBindEmail] 查询用户AuthMethod失败: %v", err)
		return errors.InternalServer("DATABASE_ERROR", "查询失败")
	}

	// 如果不存在则创建（Verified=false），否则更新（line 51-67）
	if userMethod == nil || userMethod.ID == 0 {
		_, err = r.data.db.ProxyUserAuthMethod.Create().
			SetUserID(int(userID)).
			SetAuthType("email").
			SetAuthIdentifier(email).
			SetVerified(false).
			Save(ctx)
	} else {
		err = r.data.db.ProxyUserAuthMethod.UpdateOneID(userMethod.ID).
			SetAuthIdentifier(email).
			SetVerified(false).
			Exec(ctx)
	}

	if err != nil {
		r.logger.Errorf("[UpdateBindEmail] 保存AuthMethod失败: %v", err)
		return errors.InternalServer("DATABASE_ERROR", "保存认证方法失败")
	}

	return nil
}
