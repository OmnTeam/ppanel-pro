// BindTelegram 绑定Telegram
// ⚠️ 完整复刻原项目逻辑（bindTelegramLogic.go）
func (r *publicUserRepo) BindTelegram(ctx context.Context, session string, botName string) (string, int64, error) {
	r.logger.Infof("[BindTelegram] session: %s, botName: %s", session, botName)

	// 生成Telegram bot URL（line 30-32）
	url := fmt.Sprintf("https://t.me/%s?start=%s", botName, session)
	expiredAt := time.Now().Add(300 * time.Second).UnixMilli()

	return url, expiredAt, nil
}

// UnbindTelegram 解绑Telegram
// ⚠️ 完整复刻原项目逻辑（unbindTelegramLogic.go）
func (r *publicUserRepo) UnbindTelegram(ctx context.Context, userID int64) error {
	r.logger.Infof("[UnbindTelegram] userID: %d", userID)

	// 查询telegram AuthMethod（line 43-47）
	method, err := r.data.db.ProxyUserAuthMethod.Query().
		Where(
			proxyuserauthmethod.UserIDEQ(int(userID)),
			proxyuserauthmethod.AuthTypeEQ("telegram"),
		).
		Only(ctx)

	if err != nil {
		if ent.IsNotFound(err) {
			return responsecode.NewKratosError(responsecode.ErrAuthMethodNotFound)
		}
		r.logger.Errorf("[UnbindTelegram] 查询AuthMethod失败: %v", err)
		return errors.InternalServer("DATABASE_ERROR", "查询认证方法失败")
	}

	// 删除AuthMethod（line 60-64）
	err = r.data.db.ProxyUserAuthMethod.DeleteOneID(method.ID).Exec(ctx)
	if err != nil {
		r.logger.Errorf("[UnbindTelegram] 删除AuthMethod失败: %v", err)
		return errors.InternalServer("DATABASE_ERROR", "删除认证方法失败")
	}

	// TODO: 发送Telegram通知（line 66-79）
	// 原项目使用TelegramBot发送解绑通知，这里暂时省略
	// 需要集成Telegram Bot API

	return nil
}

